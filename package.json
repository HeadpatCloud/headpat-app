    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@biomejs/biome": "2.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@types/react": "~19.3.0",
    "emojibase-data": "16.0.3",
    "expo-dev-client": "~58.0.21",
