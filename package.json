{
  "name": "headpat-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "test": "jest",
    "doctor": "npx expo-doctor@latest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "lint:fix": "biome format --write . && biome lint --fix .",
    "local:android": "bun local:android:preview",
    "local:android:development": "bunx eas build --platform android --profile development --local",
    "local:android:preview": "bunx eas build --platform android --profile preview --local",
    "local:android:production": "bunx eas build --platform android --profile production --local",
    "local:ios": "bun local:ios:preview",
    "local:ios:development": "bunx eas build --platform ios --profile development --local",
    "local:ios:preview": "bunx eas build --platform ios --profile preview --local",
    "local:ios:production": "bunx eas build --platform ios --profile production --local"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|fractional-indexing))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@better-auth/expo": "1.6.35",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@orpc/client": "1.16.4",
    "@orpc/server": "1.16.4",
    "@orpc/tanstack-query": "1.16.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@rn-primitives/portal": "~1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/expo-db-sqlite-persistence": "0.2.10",
    "@tanstack/query-db-collection": "1.2.2",
    "@tanstack/react-db": "0.1.96",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-persist-client": "^5.108.2",
    "better-auth": "1.6.35",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-age-range": "~58.0.3",
    "expo-apple-authentication": "~58.0.3",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "i18n-js": "^4.5.4",
    "lucide-react-native": "^1.77.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
