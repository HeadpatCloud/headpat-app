{
  "name": "headpat-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "test": "jest",
    "doctor": "npx expo-doctor@latest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "lint:fix": "biome format --write . && biome lint --fix .",
    "local:android": "bun local:android:preview",
    "local:android:development": "bunx eas build --platform android --profile development --local",
    "local:android:preview": "bunx eas build --platform android --profile preview --local",
    "local:android:production": "bunx eas build --platform android --profile production --local",
    "local:ios": "bun local:ios:preview",
    "local:ios:development": "bunx eas build --platform ios --profile development --local",
    "local:ios:preview": "bunx eas build --platform ios --profile preview --local",
    "local:ios:production": "bunx eas build --platform ios --profile production --local"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@better-auth/expo": "1.6.14",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.3.4",
    "@orpc/client": "1.14.3",
    "@orpc/server": "1.14.3",
    "@orpc/tanstack-query": "1.14.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "better-auth": "1.6.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57",
    "expo-age-range": "~57.0.3",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.9",
    "expo-updates": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "i18n-js": "^4.5.3",
    "lucide-react-native": "^1.31.0",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "supercluster": "^9.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "2.4.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.10",
    "@types/supercluster": "^7.1.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
